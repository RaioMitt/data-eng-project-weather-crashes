# Copy this file to .env and adjust values if needed.
# The defaults below work out of the box for local development.

POSTGRES_VERSION=16.4

# Weather database (dbt target)
WEATHER_DB_USER=weather_user
WEATHER_DB_PASSWORD=weather_pass
WEATHER_DB_NAME=weather_db
WEATHER_DB_PORT=5434

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PORT=5435

# Airflow admin UI
AIRFLOW_VERSION=2.8.1
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com

# pgAdmin
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
