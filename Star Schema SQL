CREATE TABLE IF NOT EXISTS "Crashes_fact_table" (
	"id" INTEGER NOT NULL GENERATED BY DEFAULT AS IDENTITY,
	"damage_amount" INTEGER NOT NULL,
	"personal_injury" BOOLEAN NOT NULL,
	"time_id" INTEGER,
	"location_id" INTEGER,
	"crashtype_id" INTEGER,
	"x_coordinate" INTEGER,
	"y_coordinate" INTEGER,
	"station_id" INTEGER,
	"damage_qualifier" VARCHAR(20),
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Time_dimension" (
	"id" INTEGER NOT NULL GENERATED BY DEFAULT AS IDENTITY,
	"date" DATE NOT NULL,
	"year" INTEGER NOT NULL,
	"month" INTEGER NOT NULL,
	"day" INTEGER NOT NULL,
	"weekday" VARCHAR(20),
	"hour" INTEGER NOT NULL,
	"is_weekend" BOOLEAN,
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Location_dimension" (
	"id" INTEGER NOT NULL GENERATED BY DEFAULT AS IDENTITY,
	"county" VARCHAR(50) NOT NULL,
	"municipality" VARCHAR(50),
	"settlement" VARCHAR(50),
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Weather_fact_table" (
	"id" INTEGER NOT NULL GENERATED BY DEFAULT AS IDENTITY,
	"max_temperature" DECIMAL,
	"min_temperature" DECIMAL,
	"max_wind_speed" DECIMAL,
	"precipitation" DECIMAL,
	"sunshine" DECIMAL,
	"time_id" INTEGER,
	"station_id" INTEGER,
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Crash_type_dimension" (
	"id" INTEGER NOT NULL GENERATED BY DEFAULT AS IDENTITY,
	"crash_type" VARCHAR(50),
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Weather_station_dimension" (
	"id" INTEGER NOT NULL GENERATED BY DEFAULT AS IDENTITY,
	"station_code" VARCHAR(20) NOT NULL,
	"name" VARCHAR(100) NOT NULL,
	"x_coordinate" INTEGER NOT NULL,
	"y_coordinate" INTEGER NOT NULL,
	"is_current" BOOLEAN NOT NULL,
	PRIMARY KEY("id")
);

ALTER TABLE "Time_dimension"
ADD FOREIGN KEY("id") REFERENCES "Crashes_fact_table"("time_id")
ON UPDATE NO ACTION ON DELETE NO ACTION;
ALTER TABLE "Location_dimension"
ADD FOREIGN KEY("id") REFERENCES "Crashes_fact_table"("location_id")
ON UPDATE NO ACTION ON DELETE NO ACTION;
ALTER TABLE "Crashes_fact_table"
ADD FOREIGN KEY("crashtype_id") REFERENCES "Crash_type_dimension"("id")
ON UPDATE NO ACTION ON DELETE NO ACTION;
ALTER TABLE "Weather_station_dimension"
ADD FOREIGN KEY("id") REFERENCES "Crashes_fact_table"("station_id")
ON UPDATE NO ACTION ON DELETE NO ACTION;
ALTER TABLE "Weather_station_dimension"
ADD FOREIGN KEY("id") REFERENCES "Weather_fact_table"("station_id")
ON UPDATE NO ACTION ON DELETE NO ACTION;
ALTER TABLE "Time_dimension"
ADD FOREIGN KEY("id") REFERENCES "Weather_fact_table"("time_id")
ON UPDATE NO ACTION ON DELETE NO ACTION;
